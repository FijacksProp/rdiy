# Neon PostgreSQL pooled connection string. Keep this server-side.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=replace-with-a-random-64-character-secret

# Resend is optional in local development. Records are still stored if it is absent.
RESEND_API_KEY=re_replace_with_resend_api_key
CONTACT_TO_EMAIL=rdiy.sl.org@gmail.com
RESEND_FROM_EMAIL=RDIY Website <onboarding@resend.dev>

# Comma-separated origins allowed to submit forms in addition to the current host.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Monime hosted checkout. Checkout Sessions currently require a live mon_ token.
MONIME_ACCESS_TOKEN=mon_replace_with_live_token
MONIME_SPACE_ID=spc-replace-with-rdiy-space-id
# Optional: omit to use the Space's main financial account.
MONIME_FINANCIAL_ACCOUNT_ID=
# Generate 32+ random bytes and configure this as the x-rdiy-webhook-secret header in Monime.
MONIME_WEBHOOK_SECRET=replace-with-a-random-secret-at-least-32-characters-long
MONIME_API_VERSION=caph.2025-08-23
# Leave provider lists empty to let Monime show every provider active for the Space.
MONIME_MOMO_PROVIDERS=m17,m18
MONIME_BANK_PROVIDERS=
PUBLIC_SITE_URL=http://localhost:3000
